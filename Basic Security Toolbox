    def port_scanner(self):
        """Port Scanner Profissional"""
        self.clear_screen()
        print(f"{Colors.BOLD}{Colors.HEADER}🔍 PORT SCANNER PROFISSIONAL{Colors.END}")
        print(f"{Colors.BLUE}{'='*60}{Colors.END}\n")
        
        target = self.get_target()
        self.resolve_target()
        
        if not self.target_ip:
            input("Pressiona Enter para continuar...")
            return
        
        print(f"\n{Colors.BOLD}Configuração do Scan:{Colors.END}")
        
        try:
            start_port = int(input("Porta inicial [1]: ") or "1")
            end_port = int(input("Porta final [1024]: ") or "1024")
            threads = int(input("Número de threads [100]: ") or "100")
            timeout = int(input("Timeout (segundos) [2]: ") or "2")
        except ValueError:
            print(f"{Colors.RED}[-] Valores inválidos. Usando valores padrão.{Colors.END}")
            start_port, end_port, threads, timeout = 1, 1024, 100, 2
        
        print(f"\n{Colors.BOLD}A iniciar scan em {self.target_ip}...{Colors.END}")
        print(f"Portas: {start_port}-{end_port}")
        print(f"Threads: {threads}")
        print()
        
        open_ports = []
        services = {}
        
        def scan_port(port):
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(timeout)
                result = sock.connect_ex((self.target_ip, port))
                if result == 0:
                    try:
                        service = socket.getservbyport(port)
                    except:
                        service = "unknown"
                    
                    with threading.Lock():
                        open_ports.append(port)
                        services[port] = service
                    
                    print(f"{Colors.GREEN}[ABERTA]{Colors.END} Porta {port} - {service}")
                sock.close()
            except:
                pass
        
        start_time = time.time()
        
        with ThreadPoolExecutor(max_workers=threads) as executor:
            futures = [executor.submit(scan_port, port) for port in range(start_port, end_port + 1)]
            for future in as_completed(futures):
                pass
        
        end_time = time.time()
        duration = end_time - start_time
        
        print(f"\n{Colors.BOLD}{Colors.GREEN}SCAN COMPLETO!{Colors.END}")
        print(f"Portas abertas encontradas: {len(open_ports)}")
        print(f"Tempo total: {duration:.2f} segundos")
        
        if open_ports:
            print(f"\n{Colors.BOLD}Resumo:{Colors.END}")
            for port in sorted(open_ports):
                print(f"  {Colors.GREEN}{port}{Colors.END}/tcp - {services.get(port, 'unknown')}")
        
        # Guardar resultados
        self.save_report('port_scan', {
            'target_ip': self.target_ip,
            'start_port': start_port,
            'end_port': end_port,
            'open_ports': [{'port': p, 'service': services.get(p)} for p in sorted(open_ports)],
            'duration': duration
        })
        
        self.wait_for_enter()
