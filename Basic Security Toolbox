    def web_crawler(self):
        """Web Crawler"""
        self.clear_screen()
        print(f"{Colors.BOLD}{Colors.HEADER}  WEB CRAWLER{Colors.END}")
        print(f"{Colors.BLUE}{'='*60}{Colors.END}\n")
        
        if not BS4_AVAILABLE:
            print(f"{Colors.RED}[-] BeautifulSoup não instalado. Instala com: pip install beautifulsoup4{Colors.END}")
            self.wait_for_enter()
            return
        
        target = self.get_target()
        
        max_pages = int(input("Número máximo de páginas a visitar [30]: ") or "30")
        
        print(f"\n{Colors.BOLD}A iniciar crawling em {target}...{Colors.END}")
        print(f"Máximo de páginas: {max_pages}")
        print()
        
        visited = set()
        to_visit = [target]
        pages = []
        
        try:
            while to_visit and len(visited) < max_pages:
                url = to_visit.pop(0)
                if url in visited:
                    continue
                
                try:
                    print(f"{Colors.BLUE}[*]{Colors.END} Visitando: {url}")
                    response = self.session.get(url, timeout=5, verify=False)
                    visited.add(url)
                    
                    # Guardar info da página
                    soup = BeautifulSoup(response.text, 'html.parser')
                    title = soup.find('title')
                    title_text = title.text.strip() if title else 'Sem título'
                    
                    pages.append({
                        'url': url,
                        'status': response.status_code,
                        'title': title_text,
                        'size': len(response.content)
                    })
                    
                    # Encontrar links
                    for link in soup.find_all('a', href=True):
                        href = link['href']
                        full_url = urljoin(url, href)
                        
                        if urlparse(full_url).netloc == urlparse(target).netloc:
                            if full_url not in visited and full_url not in to_visit:
                                to_visit.append(full_url)
                    
                    print(f"  Título: {title_text}")
                    print(f"  Links encontrados: {len(to_visit)}")
                    print()
                    
                except Exception as e:
                    print(f"{Colors.YELLOW}[!] Erro em {url}: {e}{Colors.END}")
            
            print(f"{Colors.GREEN}[+] Crawling completo!{Colors.END}")
            print(f"Páginas visitadas: {len(visited)}")
            
            # Guardar resultados
            self.save_report('web_crawler', {
                'target': target,
                'pages_visited': list(visited),
                'page_details': pages
            })
            
        except Exception as e:
            print(f"{Colors.RED}[-] Erro: {e}{Colors.END}")
        
        self.wait_for_enter()
