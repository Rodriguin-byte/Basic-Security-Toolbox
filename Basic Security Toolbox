    def ssl_checker(self):
        """SSL/TLS Checker"""
        self.clear_screen()
        print(f"{Colors.BOLD}{Colors.HEADER} SSL/TLS CHECKER{Colors.END}")
        print(f"{Colors.BLUE}{'='*60}{Colors.END}\n")
        
        target = self.get_target()
        hostname = target.replace('http://', '').replace('https://', '').split('/')[0]
        
        print(f"{Colors.BOLD}A verificar SSL em {hostname}...{Colors.END}\n")
        
        try:
            import ssl
            import socket
            from datetime import datetime
            
            context = ssl.create_default_context()
            with socket.create_connection((hostname, 443), timeout=10) as sock:
                with context.wrap_socket(sock, server_hostname=hostname) as ssock:
                    cert = ssock.getpeercert()
                    
                    # Informações do certificado
                    print(f"{Colors.GREEN}✓{Colors.END} Certificado SSL válido")
                    
                    # Emitente
                    issuer = dict(x[0] for x in cert['issuer'])
                    print(f"  Emitente: {issuer.get('organizationName', 'Desconhecido')}")
                    
                    # Sujeito
                    subject = dict(x[0] for x in cert['subject'])
                    print(f"  Domínio: {subject.get('commonName', 'Desconhecido')}")
                    
                    # Datas
                    not_before = datetime.strptime(cert['notBefore'], '%b %d %H:%M:%S %Y %Z')
                    not_after = datetime.strptime(cert['notAfter'], '%b %d %H:%M:%S %Y %Z')
                    days_left = (not_after - datetime.now()).days
                    
                    print(f"  Válido de: {not_before}")
                    print(f"  Válido até: {not_after}")
                    print(f"  Dias restantes: {days_left}")
                    
                    # SANs
                    sans = []
                    for ext in cert.get('subjectAltName', []):
                        if ext[0] == 'DNS':
                            sans.append(ext[1])
                    
                    if sans:
                        print(f"  SANs: {', '.join(sans[:5])}{'...' if len(sans) > 5 else ''}")
                    
                    # Versão TLS
                    print(f"  Versão TLS: {ssock.version()}")
                    
                    # Cipher
                    print(f"  Cipher: {ssock.cipher()[0]}")
                    
                    if days_left < 30:
                        print(f"\n{Colors.YELLOW}  Certificado expira em breve!{Colors.END}")
                    
                    # Guardar resultados
                    self.save_report('ssl_checker', {
                        'hostname': hostname,
                        'issuer': issuer.get('organizationName', ''),
                        'subject': subject.get('commonName', ''),
                        'valid_from': not_before.isoformat(),
                        'valid_until': not_after.isoformat(),
                        'days_left': days_left,
                        'sans': sans,
                        'tls_version': ssock.version(),
                        'cipher': ssock.cipher()[0]
                    })
                    
        except Exception as e:
            print(f"{Colors.RED}[-] Erro: {e}{Colors.END}")
            print(f"  O site pode não suportar HTTPS ou ter um certificado inválido.")
        
        self.wait_for_enter()
    
