                                        'parameter': param_name,
                                        'payload': payload,
                                        'response_time': elapsed
                                    })
                                    
                        except:
                            pass
        
        if not vulnerabilities:
            print(f"{Colors.GREEN}[+] Nenhuma vulnerabilidade SQL encontrada{Colors.END}")
        
        # Guardar resultados
        self.save_report('sql_injection', {
            'target': target,
