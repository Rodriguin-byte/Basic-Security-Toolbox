    def get_target(self):
        """Obtém e valida o alvo"""
        if not self.target:
            self.target = input(f"{Colors.BOLD}URL ou IP alvo: {Colors.END}").strip()
            
            # Adicionar protocolo se necessário
            if not self.target.startswith(('http://', 'https://')) and not self.is_ip(self.target):
                self.target = 'http://' + self.target
                print(f"{Colors.YELLOW}[!] Protocolo adicionado: {self.target}{Colors.END}")
        
        return self.target
    
    def is_ip(self, value):
        """Verifica se é um IP válido"""
        try:
            ipaddress.ip_address(value)
            return True
        except:
            return False
    
    def resolve_target(self):
        """Resolve domínio para IP"""
        if self.is_ip(self.target):
            self.target_ip = self.target
            return self.target_ip
        
        try:
            self.target_ip = socket.gethostbyname(self.target.replace('http://', '').replace('https://', ''))
            print(f"{Colors.GREEN}[+] Domínio resolvido: {self.target_ip}{Colors.END}")
            return self.target_ip
        except:
            print(f"{Colors.RED}[-] Erro ao resolver domínio{Colors.END}")
            return None
    
