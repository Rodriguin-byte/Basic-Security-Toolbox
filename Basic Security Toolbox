            'wp-admin', 'wp-content', 'wp-includes', 'includes', 'temp',
            'logs', 'test', 'dev', 'api', 'v1', 'v2', 'phpinfo', 'info',
            'login', 'signin', 'register', 'user', 'users', 'profile',
            'database', 'db', 'sql', 'mysql', 'php', 'html', 'htaccess',
            '.git', '.env', 'robots.txt', 'sitemap.xml', 'crossdomain.xml'
        ]
        
        print(f"{Colors.BOLD}Configuração:{Colors.END}")
        threads = int(input("Número de threads [20]: ") or "20")
        
        # Extensões comuns
        extensions_input = input("Extensões para testar (separadas por vírgula) [php,asp,txt,bak]: ").strip()
        if extensions_input:
            extensions = [e.strip() for e in extensions_input.split(',')]
        else:
            extensions = ['php', 'asp', 'txt', 'bak', 'old', 'zip', 'tar', 'gz']
        
        print(f"\n{Colors.BOLD}A iniciar brute force em {target}...{Colors.END}")
        print(f"Palavras: {len(wordlist)}")
        print(f"Extensões: {', '.join(extensions)}")
        print()
        
        found_urls = []
        
        def check_url(path):
            url = urljoin(target, path)
            try:
                response = self.session.get(url, timeout=5, verify=False, allow_redirects=False)
                
                if response.status_code == 200:
                    print(f"{Colors.GREEN}[200]{Colors.END} {url}")
                    found_urls.append({'url': url, 'status': 200, 'type': 'file' if '.' in path else 'dir'})
                elif response.status_code in [301, 302, 303]:
                    location = response.headers.get('Location', '')
                    print(f"{Colors.YELLOW}[{response.status_code}]{Colors.END} {url} -> {location}")
                    found_urls.append({'url': url, 'status': response.status_code, 'redirect': location})
                elif response.status_code in [401, 403]:
                    print(f"{Colors.YELLOW}[{response.status_code}]{Colors.END} {url} (Acesso negado)")
                    found_urls.append({'url': url, 'status': response.status_code, 'type': 'restricted'})
            except:
                pass
        
        # Testar diretórios
        with ThreadPoolExecutor(max_workers=threads) as executor:
            futures = []
            for word in wordlist:
                futures.append(executor.submit(check_url, word))
                for ext in extensions:
                    futures.append(executor.submit(check_url, f"{word}.{ext}"))
            
            for future in as_completed(futures):
                pass
        
        print(f"\n{Colors.BOLD}{Colors.GREEN}BRUTE FORCE COMPLETO!{Colors.END}")
        print(f"URLs encontradas: {len(found_urls)}")
        
        # Guardar resultados
        self.save_report('dir_bruteforce', {
            'target': target,
            'urls_found': found_urls
        })
        
        self.wait_for_enter()
