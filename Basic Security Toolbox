    def full_report(self):
        """Executa todas as ferramentas e gera relatório completo"""
        self.clear_screen()
        print(f"{Colors.BOLD}{Colors.HEADER}📊 RELATÓRIO COMPLETO{Colors.END}")
        print(f"{Colors.BLUE}{'='*60}{Colors.END}\n")
        
        target = self.get_target()
        self.resolve_target()
        
        print(f"{Colors.YELLOW}[!] Isto pode demorar alguns minutos...{Colors.END}\n")
        
        full_results = {
            'target': target,
            'target_ip': self.target_ip,
            'timestamp': datetime.now().isoformat(),
            'tools': {}
        }
        
        # 1. Security Headers
        print(f"\n{Colors.BOLD}1. Analisando Security Headers...{Colors.END}")
        try:
            response = self.session.get(target, timeout=10, verify=False)
            headers = response.headers
            security_headers = ['Strict-Transport-Security', 'Content-Security-Policy', 
                               'X-Frame-Options', 'X-Content-Type-Options', 'X-XSS-Protection']
            
            present = [h for h in security_headers if h in headers]
            full_results['tools']['security_headers'] = {
                'present': present,
                'missing': [h for h in security_headers if h not in headers],
                'score': len(present)/len(security_headers)*100
            }
            print(f"{Colors.GREEN}  ✓ Headers analisados{Colors.END}")
        except:
            print(f"{Colors.RED}  ✗ Erro nos headers{Colors.END}")
        
        # 2. Port Scan (portas comuns)
        print(f"\n{Colors.BOLD}2. Scan de portas comuns...{Colors.END}")
        open_ports = []
        common_ports = [21,22,23,25,53,80,110,111,135,139,143,443,445,993,995,3306,3389,5900,8080,8443]
        
        def check_port(port):
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(1)
                result = sock.connect_ex((self.target_ip, port))
                if result == 0:
                    open_ports.append(port)
                sock.close()
            except:
                pass
        
        with ThreadPoolExecutor(max_workers=20) as executor:
            executor.map(check_port, common_ports)
        
        full_results['tools']['port_scan'] = {'open_ports': open_ports}
        print(f"{Colors.GREEN}  ✓ Portas abertas: {len(open_ports)}{Colors.END}")
        
        # 3. WAF Detection
        print(f"\n{Colors.BOLD}3. Detectando WAF...{Colors.END}")
        waf_detected = []
        try:
            response = self.session.get(target, timeout=10, verify=False)
            waf_signatures = {'Cloudflare': '__cfduid', 'AWS': 'awselb', 'F5': 'BigIP'}
            
            for waf, sig in waf_signatures.items():
                for cookie in response.cookies:
                    if sig in cookie.name:
                        waf_detected.append(waf)
                        break
            
            full_results['tools']['waf_detection'] = {'waf_detected': waf_detected}
            print(f"{Colors.GREEN}  ✓ WAF: {waf_detected if waf_detected else 'Nenhum detectado'}{Colors.END}")
        except:
            print(f"{Colors.RED}  ✗ Erro no WAF{Colors.END}")
        
        # 4. SSL Info (se HTTPS)
        print(f"\n{Colors.BOLD}4. Verificando SSL...{Colors.END}")
        if target.startswith('https://'):
            try:
                import ssl
                hostname = target.replace('https://', '').split('/')[0]
                context = ssl.create_default_context()
                with socket.create_connection((hostname, 443), timeout=5) as sock:
                    with context.wrap_socket(sock, server_hostname=hostname) as ssock:
                        cert = ssock.getpeercert()
                        full_results['tools']['ssl_info'] = {
                            'tls_version': ssock.version(),
                            'cipher': ssock.cipher()[0]
                        }
                print(f"{Colors.GREEN}  ✓ SSL OK{Colors.END}")
            except:
                print(f"{Colors.RED}  ✗ Erro SSL{Colors.END}")
        
        # Guardar relatório completo
        filename = self.save_report('complete_scan', full_results)
        
        print(f"\n{Colors.GREEN}{Colors.BOLD}RELATÓRIO COMPLETO GERADO!{Colors.END}")
        print(f"Ficheiro: {filename}")
        
        # Mostrar resumo
        print(f"\n{Colors.BOLD}Resumo:{Colors.END}")
        print(f"  Target: {target}")
        print(f"  IP: {self.target_ip}")
        print(f"  Portas abertas: {len(open_ports)}")
        print(f"  WAF: {waf_detected[0] if waf_detected else 'Não detectado'}")
        
        self.wait_for_enter()
    
