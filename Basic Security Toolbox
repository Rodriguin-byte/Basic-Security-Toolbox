        self.clear_screen()
        print(f"{Colors.BOLD}{Colors.HEADER} WAF DETECTOR{Colors.END}")
        print(f"{Colors.BLUE}{'='*60}{Colors.END}\n")
        
        target = self.get_target()
        
        waf_signatures = {
            'Cloudflare': ['cloudflare', '__cfduid'],
            'AWS WAF': ['awselb', 'x-amzn-RequestId'],
            'ModSecurity': ['mod_security', 'NOYB'],
            'F5 BIG-IP': ['BigIP', 'F5'],
            'Sucuri': ['Sucuri', 'cloudproxy'],
            'Wordfence': ['wordfence'],
            'Akamai': ['akamai'],
            'Barracuda': ['barracuda'],
            'Imperva': ['imperva', 'incapsula']
        }
        
        print(f"{Colors.BOLD}A detetar WAF em {target}...{Colors.END}\n")
        
        detected = []
        
        try:
            # Verificar headers
            response = self.session.get(target, timeout=10, verify=False)
            
            for waf, signatures in waf_signatures.items():
                for sig in signatures:
                    # Verificar em headers
                    for header, value in response.headers.items():
                        if sig.lower() in header.lower() or sig.lower() in value.lower():
                            print(f"{Colors.GREEN}[WAF DETECTADO]{Colors.END} {waf} (header: {header})")
                            detected.append({'waf': waf, 'evidence': f'{header}: {value}', 'method': 'header'})
                            break
                    
                    # Verificar em cookies
                    for cookie in response.cookies:
                        if sig.lower() in cookie.name.lower() or sig.lower() in cookie.value.lower():
                            print(f"{Colors.GREEN}[WAF DETECTADO]{Colors.END} {waf} (cookie: {cookie.name})")
                            detected.append({'waf': waf, 'evidence': f'cookie: {cookie.name}', 'method': 'cookie'})
                            break
            
            # Teste com payload malicioso
            test_payload = "' OR 1=1 --"
            test_url = f"{target}?test={quote_plus(test_payload)}"
            response2 = self.session.get(test_url, verify=False, timeout=5)
            
            if response2.status_code in [403, 406, 429, 503]:
                print(f"{Colors.YELLOW}[!] Possível WAF detectado por bloqueio (status: {response2.status_code}){Colors.END}")
                detected.append({'waf': 'Unknown', 'evidence': f'HTTP {response2.status_code}', 'method': 'blocking'})
            
            if not detected:
                print(f"{Colors.YELLOW}[!] Nenhum WAF claramente identificado{Colors.END}")
            
        except Exception as e:
            print(f"{Colors.RED}[-] Erro: {e}{Colors.END}")
        
        # Guardar resultados
        self.save_report('waf_detector', {
            'target': target,
            'waf_detected': detected
        })
        
        self.wait_for_enter()
